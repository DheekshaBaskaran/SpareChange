{
  "name": "sparechange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3402",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "worker:remote": "node worker/server.mjs",
    "worker:test": "node worker/workload.mjs",
    "docker:build": "docker build -t sparechange-worker:latest worker/"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/next": "2.28.0",
    "lucide-react": "1.53.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
