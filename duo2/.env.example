# ─────────────────────────────────────────────────────────────
# SpareChange environment variables.
# Copy this file to .env.local and fill in what you need:
#     cp .env.example .env.local
# Every value is optional: with nothing set, SpareChange runs in
# full demo-safe mode (demo deals, local worker, mock payments).
# NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Compute execution ────────────────────────────────────────
# auto | remote | local-docker | local-process | mock
# "auto" tries remote → local-docker → local-process → mock.
EXECUTION_MODE=auto
# How long the demo workload trains, in seconds.
WORKLOAD_SECONDS=6
# Docker image for the worker (built automatically from worker/ if missing).
DOCKER_IMAGE=sparechange-worker:latest

# Remote worker (worker/server.mjs running on another machine).
REMOTE_WORKER_URL=
REMOTE_WORKER_TOKEN=

# ── Payments ─────────────────────────────────────────────────
# mock | x402   (x402 falls back to mock if not configured or if it fails)
PAYMENT_MODE=mock

# Buyer agent wallet private key. TESTNET ONLY. Server-side only.
X402_BUYER_PRIVATE_KEY=
# Wallet address that receives payment (the compute provider).
X402_PROVIDER_WALLET_ADDRESS=
# Optional, for three-party deals: the capacity holder's (Atlas's) agent key. TESTNET ONLY.
# Its address receives the buyer's payment (if X402_PROVIDER_WALLET_ADDRESS is empty)
# and it pays the replacement provider for the backfill.
X402_PROVIDER_PRIVATE_KEY=
# Optional: wallet of the replacement provider (Nova) that receives the backfill payment.
X402_REPLACEMENT_WALLET_ADDRESS=
# eip155:84532 = Base Sepolia testnet
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# USD amount per settlement, without a "$" (.env files treat "$" as a variable).
X402_SETTLEMENT_PRICE=0.01

# ── Duo 1 (Relay) integration ────────────────────────────────
# When these are set, deals come from Relay, every execution is authorized
# there before any compute runs, and verified usage is reported back with the
# `worker` credential. Leave unset to run standalone with demo deals.
DUO1_API_URL=
DUO1_AGENT_API_KEY=
DUO1_WORKER_API_KEY=
# Optional shared secret for POST /api/relay/pay.
DUO2_INTERNAL_TOKEN=

# Legacy read-only JSON feeds (used only when DUO1_API_URL is not set).
DUO1_DEALS_URL=
DUO1_MARKET_URL=

# Base URL of this app (the x402 buyer agent calls the provider endpoint here).
APP_BASE_URL=http://localhost:3402

# ── Solana Devnet provider payout ────────────────────────────
# Direct native-SOL transfer for the provider payout leg. Separate from the
# Base Sepolia x402 buyer payment: no bridge, no shared balance.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=solana-devnet
# JSON byte array of the devnet payer keypair. TESTNET ONLY.
SOLANA_PAYER_SECRET_KEY=
# The only address a payout may be sent to (allowlist + recipient validation).
SOLANA_PAYOUT_ADDRESS=
# Demonstration-scale transfer: 10,000,000 lamports = 0.01 SOL.
SOLANA_PAYOUT_LAMPORTS=10000000
