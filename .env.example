# Relay — Duo 1 + Market Intelligence
#
# One Tiger Data / TimescaleDB database serves both services. Copy this file to
# `.env` at the repository root and fill in real values. Never commit `.env`.
#
# Schema layout:
#   public          Market Intelligence tables (authoritative market data)
#   relay           Duo 1 finance, CREAO, Elastic projection (npm package)
# Both services share DATABASE_URL; each applies its own search_path.

# ─── Database ────────────────────────────────────────────────────────────────
# Tiger Data / Timescale Cloud (canonical relational + time-series store).
# Runtime role: DML only (no DDL) for the market API.
DATABASE_URL=postgresql://relay_market_app:REPLACE_ME@YOUR_SERVICE.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Owner role: used only by migrations and role bootstrap. Never ship to the API.
MIGRATION_DATABASE_URL=

# ─── Duo 1 API ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# CREAO agent credential. Sent by the hosted agent as a Bearer token.
# Generate with: npm run key:create -- --name "CREAO Deal Coordinator" --role agent
RELAY_API_KEY=

# Optional demo human credential for a participant approver.
# The seed links this key to Acme Compute's human user and party when set.
RELAY_HUMAN_API_KEY=

# Duo 2 settlement credential (`worker` role): usage ingestion, settlement
# confirmation, and payment submission under /internal/v1/duo2. Server-side
# only; never ship it to a browser.
DUO2_WORKER_API_KEY=

# Set to 1 only for local/reference-server testing. Never in a live environment.
RELAY_ALLOW_SIMULATED_APPROVALS=0

# Set to 1 on Tiger Data to convert Duo 1 market/execution tables to hypertables.
RELAY_TIMESCALE=0

# ─── Duo 1 → Market Intelligence bridge ──────────────────────────────────────
# The finance solver reads `relay.market_offers`. This bridge materializes fresh
# public reference offers from the Market Intelligence API into that table.
# Leave MARKET_API_URL unset to keep the bridge disabled (finance keeps working).
# Local development: http://127.0.0.1:8099. Compose overrides this to
# http://api:8000 so the two containers share a private network.
MARKET_API_URL=http://127.0.0.1:8099
# Optional bearer token; only required when calling admin endpoints.
MARKET_API_TOKEN=
# Reference offers expire after this many seconds. Live inventory is short-lived.
MARKET_OFFER_TTL_SECONDS=900
MARKET_ADVERTISED_OFFER_TTL_SECONDS=21600
# 0 disables the background sync loop (manual POST /v1/market/sync still works).
MARKET_SYNC_INTERVAL_MS=300000
MARKET_SYNC_MAX_OFFERS=1000

# ─── Elasticsearch Serverless + Agent Builder ────────────────────────────────
# Leave unset for the normal degraded mode: finance and settlement keep working,
# and investigation calls return 503 without changing any accounting state.
# ELASTIC_ENABLED=1
# ELASTICSEARCH_URL=https://your-project.es.region.elastic-cloud.com
# KIBANA_URL=https://your-project.kb.region.elastic-cloud.com
# Elastic API keys are server-side only. Bootstrap needs index manage/read/write,
# and Kibana feature_agentBuilder.all. After bootstrap, rotate to an index
# read/write key and Kibana feature_agentBuilder.read for runtime. See
# docs/ELASTIC_INTEGRATION.md for exact role descriptors.
# ELASTICSEARCH_API_KEY=
# KIBANA_API_KEY=
# ELASTIC_FINANCIAL_INDEX=relay-financial-v1
# ELASTIC_INVESTIGATOR_AGENT_ID=relay-financial-investigator
# ELASTIC_KIBANA_SPACE=default
# ELASTIC_SYNC_INTERVAL_MS=15000
# ELASTIC_INVESTIGATION_TIMEOUT_MS=120000
# ELASTIC_MAX_SYNC_BATCH=200
# ELASTIC_MAX_BACKFILL_PER_TYPE=5000

# ─── Market Intelligence ingestion (Apify + providers) ───────────────────────
# Admin token for ingestion routes (generate a long random value).
MARKET_ADMIN_TOKEN=REPLACE_ME

# Apify (Actor mode and direct dataset ingestion)
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Provider credentials. Vast.ai public search and RunPod pricing work without keys.
VASTAI_API_KEY=
RUNPOD_API_KEY=
LAMBDA_API_KEY=
TENSORDOCK_API_KEY=

# Public hostnames for the combined Vultr/Caddy deployment. Caddy terminates TLS
# for both services and is the only container that publishes ports 80/443.
MARKET_DOMAIN=market-api.example.com
DUO1_DOMAIN=api.example.com

# Market Intelligence runtime tuning
MARKET_FRESH_TTL_SECONDS=900
MARKET_ADVERTISED_TTL_SECONDS=21600
MARKET_HTTP_TIMEOUT_SECONDS=20
MARKET_MAX_INGEST_ITEMS=1000
MARKET_OBSERVATION_BUCKET_SECONDS=300
MARKET_REOBSERVE_SECONDS=300
MARKET_INGESTION_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
