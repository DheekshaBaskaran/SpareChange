{$MARKET_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$DUO2_DOMAIN} {
	encode zstd gzip
	reverse_proxy duo2:3402

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$DUO1_DOMAIN} {
	encode zstd gzip
	reverse_proxy duo1:4000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Health checks are cheap and unauthenticated; keep them out of access logs.
	@health path /v1/health
	log_skip @health
}
